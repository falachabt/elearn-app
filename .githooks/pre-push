#!/bin/sh
# Garde-fou local avant tout push (regle AGENTS.md section 3) : le workflow GitHub
# « EAS preview » refuse de publier une OTA si le typage TypeScript ou la suite Jest
# echoue. On execute donc exactement ces deux controles ici, pour les attraper en
# quelques secondes au lieu de laisser un run CI rouge et une OTA non publiee.
#
# Activation (une seule fois par clone) :
#   git config core.hooksPath .githooks
#
# Contournement exceptionnel, a utiliser en connaissance de cause :
#   SKIP_PRE_PUSH=1 git push
#
# Le hook ne se declenche pas pour un push qui ne touche aucun fichier du frontend.

if [ "${SKIP_PRE_PUSH:-0}" = "1" ]; then
  echo "[pre-push] SKIP_PRE_PUSH=1 : controles locaux ignores."
  exit 0
fi

# Git pour Windows lance les hooks avec un PATH qui n'inclut pas ses propres outils
# Unix : sans cette ligne, grep/sed/find sont introuvables et les controles
# seraient silencieusement ignores. Les doublons sont sans effet.
PATH="/usr/bin:/bin:/mingw64/bin:$PATH"
export PATH

# Git passe (nom_remote, url_remote) en $1/$2 et les lignes
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" sur son entree standard.
zero="0000000000000000000000000000000000000000"
touches=""
branche=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  branche="${remote_ref#refs/heads/}"
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-parse "$local_sha~1" 2>/dev/null || echo "$local_sha")
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  lignes=$(git diff --name-only "$range" -- 2>/dev/null | grep -E '^(src/|assets/|app\.config\.ts|app\.json|package\.json|package-lock\.json|tsconfig\.json|babel\.config\.js|jest\.setup\.js|jest\.apres\.js)' || true)
  if [ -n "$lignes" ]; then
    touches=$(printf '%s\n%s\n' "$touches" "$lignes" | sed '/^$/d' | sort -u)
  fi
done

if [ -z "$touches" ]; then
  echo "[pre-push] Aucun fichier applicatif modifie : controles locaux ignores."
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] npm introuvable dans le PATH : controles locaux ignores."
  exit 0
fi

# Plafonne le tas V8 pour eviter que tsc / eslint / jest ne saturent la RAM locale.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=2048}"

echo "[pre-push] Fichiers applicatifs pousses sur ${branche:-la branche} :"
printf '%s\n' "$touches" | while IFS= read -r fichier; do
  [ -n "$fichier" ] && printf '  - %s\n' "$fichier"
done

echo "[pre-push] 1/3 Typage TypeScript (npm run typecheck)"
if ! npm run --silent typecheck; then
  echo "" >&2
  echo "[pre-push] ECHEC du typage TypeScript. Push annule." >&2
  echo "[pre-push] Corrige les erreurs ci-dessus, ou force avec : SKIP_PRE_PUSH=1 git push" >&2
  exit 1
fi

fichiers_lint=$(printf '%s\n' "$touches" | grep -E '\.(ts|tsx|js|jsx)$' | tr '\n' ' ')
if [ -n "$fichiers_lint" ]; then
  echo "[pre-push] 2/3 ESLint sur les fichiers modifies"
  # shellcheck disable=SC2086
  if ! npx eslint --quiet $fichiers_lint; then
    echo "" >&2
    echo "[pre-push] ECHEC d'ESLint. Push annule : le job verifier de EAS preview echouerait." >&2
    echo "[pre-push] Corrige les erreurs ci-dessus, ou force avec : SKIP_PRE_PUSH=1 git push" >&2
    exit 1
  fi
fi

# Si la configuration de compilation (package.json, babel, tsconfig) a change ou si FULL_PRE_PUSH=1,
# on lance toute la suite ; sinon uniquement les tests lies aux fichiers modifies (--findRelatedTests).
config_touchee=$(printf '%s\n' "$touches" | grep -E '^(package\.json|package-lock\.json|tsconfig\.json|babel\.config\.js)$' || true)
fichiers_jest=$(printf '%s\n' "$touches" | grep -E '^src/.*\.(ts|tsx|js|jsx)$' | tr '\n' ' ')

if [ "${FULL_PRE_PUSH:-0}" = "1" ] || [ -n "$config_touchee" ]; then
  echo "[pre-push] 3/3 Tests Jest complets (--runInBand --ci)"
  if ! npx jest --runInBand --ci --silent; then
    echo "" >&2
    echo "[pre-push] ECHEC de la suite Jest. Push annule." >&2
    exit 1
  fi
elif [ -n "$fichiers_jest" ]; then
  echo "[pre-push] 3/3 Tests Jest lies aux fichiers modifies (--findRelatedTests)"
  # shellcheck disable=SC2086
  if ! npx jest --runInBand --ci --bail --findRelatedTests $fichiers_jest; then
    echo "" >&2
    echo "[pre-push] ECHEC des tests Jest lies. Push annule." >&2
    echo "[pre-push] Corrige les tests ci-dessus, ou force avec : SKIP_PRE_PUSH=1 git push" >&2
    exit 1
  fi
fi

echo "[pre-push] Typage, lint et tests OK : push autorise."
exit 0
