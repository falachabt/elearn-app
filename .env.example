# Copier vers .env.local (ignoré par git). Ne jamais committer de vraies clés.
# Valeurs dans Supabase > Project Settings > API (clé "anon" / publishable uniquement).
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Analytics PostHog (optionnel : sans clé, l'analytics est désactivé). Clé projet publique uniquement.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Connexion Postgres directe, pour les migrations et les scripts. Contient le mot de passe
# de la base : à ne jamais committer, à stocker dans le gestionnaire de secrets de l'équipe.
DATABASE_URL=

# Fournisseurs tiers facturés à l'usage.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_QWEN_API_KEY=

# Paiement mobile money.
EXPO_PUBLIC_NOTCHPAY_API_KEY=
