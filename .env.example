# Copier vers .env.local (ignoré par git). Ne jamais committer de vraies clés.
# Valeurs dans Supabase > Project Settings > API (clé "anon" / publishable uniquement).
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Analytics PostHog (optionnel : sans clé, l'analytics est désactivé). Clé projet publique uniquement.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
